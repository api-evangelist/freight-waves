{
  "opencollection": "1.0.0",
  "info": {
    "name": "FreightWaves SONAR Authentication API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Authenticate and retrieve an API bearer token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.freightwaves.com/Credential/authenticate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Exchange a SONAR username and password for a bearer token valid for one year. Re-authenticating issues a new token without invalidating previous tokens; SONAR recommends refreshing the token on a regular cadence."
        }
      ]
    }
  ],
  "bundled": true
}